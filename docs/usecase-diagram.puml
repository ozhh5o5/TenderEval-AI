@startuml TenderEval_AI_UseCaseDiagram

' ── Page & Theme Settings (16:9 PPT) ──
skinparam pageMargin 10
skinparam shadowing true
skinparam handwritten false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 14

' Force extreme compactness & horizontal layout
left to right direction
skinparam nodesep 25
skinparam ranksep 40

' ── Golden Theme ──
skinparam backgroundColor #FFF8E7
skinparam usecaseBackgroundColor #FFFAED
skinparam usecaseBorderColor #C8A951
skinparam usecaseFontColor #3D2B00
skinparam usecaseFontSize 13

skinparam actorBorderColor #8B6914
skinparam actorBackgroundColor #FFE9A0
skinparam actorFontColor #3D2B00
skinparam actorFontSize 13
skinparam actorFontStyle bold

skinparam rectangleBorderColor #C8A951
skinparam rectangleBackgroundColor #FFFDF5
skinparam rectangleFontColor #5C4300
skinparam rectangleFontSize 16
skinparam rectangleFontStyle bold

skinparam arrowColor #8B6914
skinparam arrowFontColor #5C4300
skinparam arrowFontSize 11

' ── Title ──
title <size:24><b><color:#5C4300>TenderEval AI — Use Case Diagram</color></b></size>

' ── System Boundary ──
rectangle "TenderEval AI Platform" as SYS {
  usecase "1. Extract Tender Criteria" as UC1
  usecase "2. Parse Bidder Documents" as UC2
  usecase "3. Evaluate & Anchor Evidence" as UC3
  usecase "4. Detect Bid-Rigging (TGNN)" as UC4
  usecase "5. Verify Govt Statutory Data" as UC5
  usecase "6. Audit & Override Verdicts" as UC6
}

' ── Human Actors (Left) ──
actor "Procurement\nOfficer" as PO #FFE9A0
actor "Evaluation\nCommittee" as EC #FFE9A0
actor "Bidder" as BD #FFE9A0

' ── System Actors (Right) ──
actor "AI & OCR\nEngine" as AI <<System>> #FFDEAD
actor "External\nGovt DBs" as GOV <<System>> #FFDEAD

' ── Relationships ──
PO --> UC1
PO --> UC3
EC --> UC6
BD --> UC2

UC1 <-- AI
UC2 <-- AI
UC3 <-- AI
UC4 <-- AI

UC5 <-- GOV

' Connections between Use Cases to show flow
UC1 .> UC3 : <<feeds>>
UC2 .> UC3 : <<feeds>>
UC3 .> UC6 : <<audited by>>

' ── Legend ──
legend bottom right
  |<#FFE9A0> <b>Human Actor</b> | <#FFDEAD> <b>System Actor</b> |
endlegend

@enduml
